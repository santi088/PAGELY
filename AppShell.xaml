<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PAGELY.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PAGELY.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{DynamicResource Surface}"
    Shell.TitleColor="{DynamicResource Ink}"
    Shell.ForegroundColor="{DynamicResource Primary}"
    Shell.TabBarBackgroundColor="{DynamicResource Surface}"
    Shell.TabBarTitleColor="{DynamicResource Primary}"
    Shell.TabBarUnselectedColor="{DynamicResource Muted}"
    Shell.NavBarHasShadow="False"
    Shell.DisabledColor="{DynamicResource PrimaryDark}"
    Shell.TabBarIsVisible="True"
    Title="PAGELY">

    <TabBar x:Name="MainTabBar">
        <Tab Title="My Library" Icon="tab_library.svg">
            <ShellContent
                ContentTemplate="{DataTemplate views:LibraryPage}"
                Route="library"
                Shell.NavBarIsVisible="False" />
        </Tab>
        <Tab Title="Discover" Icon="tab_discover.svg">
            <ShellContent
                ContentTemplate="{DataTemplate views:DiscoverPage}"
                Route="discover"
                Shell.NavBarIsVisible="False" />
        </Tab>
        <Tab Title="Search" Icon="tab_search.svg">
            <ShellContent
                ContentTemplate="{DataTemplate views:SearchPage}"
                Route="search"
                Shell.NavBarIsVisible="False" />
        </Tab>
        <Tab Title="Profile" Icon="tab_profile.svg">
            <ShellContent
                ContentTemplate="{DataTemplate views:ProfilePage}"
                Route="profile"
                Shell.NavBarIsVisible="False" />
        </Tab>
    </TabBar>

    <ShellContent
        Route="reader"
        ContentTemplate="{DataTemplate views:ReaderPage}"
        Shell.TabBarIsVisible="False"
        Shell.NavBarIsVisible="False" />
    <ShellContent
        Route="bookdetail"
        ContentTemplate="{DataTemplate views:BookDetailPage}"
        Shell.TabBarIsVisible="False"
        Shell.NavBarIsVisible="False" />
</Shell>
