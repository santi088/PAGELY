<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAGELY.Views.DiscoverBookDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PAGELY.Models"
    xmlns:vm="clr-namespace:PAGELY.ViewModels"
    x:DataType="vm:DiscoverBookDetailViewModel"
    Title="Book details"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource Paper}">

    <Grid RowDefinitions="Auto,*">
        <Border
            BackgroundColor="{DynamicResource Surface}"
            Stroke="{DynamicResource Divider}"
            StrokeShape="RoundRectangle 0,0,20,20"
            StrokeThickness="1">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" Padding="12,10,16,12">
                <ImageButton
                    Aspect="AspectFit"
                    BackgroundColor="{DynamicResource SurfaceAlt}"
                    BorderColor="{DynamicResource Divider}"
                    BorderWidth="1"
                    Clicked="OnBackClicked"
                    CornerRadius="21"
                    HeightRequest="42"
                    Padding="0"
                    SemanticProperties.Description="Back"
                    Source="ic_back.svg"
                    WidthRequest="42" />
                <Label
                    Grid.Column="1"
                    FontFamily="OpenSansSemibold"
                    FontSize="17"
                    Padding="12,0,0,0"
                    Text="Book details"
                    TextColor="{DynamicResource Ink}"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,16,20,40" Spacing="14" IsVisible="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                <Border Padding="14" Style="{StaticResource CardBorder}">
                    <Grid ColumnDefinitions="84,*" ColumnSpacing="14">
                        <Border
                            BackgroundColor="{Binding Book.CoverColor}"
                            HeightRequest="118"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0"
                            VerticalOptions="Start"
                            WidthRequest="84">
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="28"
                                HorizontalOptions="Center"
                                Text="{Binding Book.Initial}"
                                TextColor="{DynamicResource Surface}"
                                VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                            <Label FontSize="18" Style="{StaticResource CardTitle}" Text="{Binding Book.Title}" />
                            <Label FontSize="13" Style="{StaticResource CardMeta}" Text="{Binding Book.Author}" />
                            <Label FontSize="12" Style="{StaticResource Caption}" Text="{Binding Book.Genre}" />
                            <Label FontSize="12" Style="{StaticResource Caption}" Text="{Binding Book.RatingLabel}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Padding="16" Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource SectionCaption}" Text="DESCRIPTION" />
                        <Label Style="{StaticResource PageSubtitle}" Text="{Binding Book.Description}" />
                    </VerticalStackLayout>
                </Border>

                <Button
                    Style="{StaticResource ButtonPrimary}"
                    Text="Add to reading list"
                    Command="{Binding ToggleSaveCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsSaved}" Value="True">
                            <Setter Property="Text" Value="Remove from reading list" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Border Padding="16" Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource SectionCaption}" Text="REVIEWS" />
                        <Label Style="{StaticResource PageSubtitle}" Text="{Binding ReviewStatus}" />
                        <CollectionView ItemsSource="{Binding Reviews}" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout ItemSpacing="8" Orientation="Vertical" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Review">
                                    <Border Padding="10" Style="{StaticResource CardBorder}">
                                        <VerticalStackLayout Spacing="4">
                                            <Label FontSize="13" Style="{StaticResource CardTitle}" Text="{Binding UserEmail}" />
                                            <Label FontSize="12" Style="{StaticResource Caption}" Text="{Binding Rating, StringFormat='Rating: {0}'}" />
                                            <Label FontSize="14" Text="{Binding ReviewText}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Label Style="{StaticResource SectionCaption}" Text="WRITE A REVIEW" />
                        <Entry Placeholder="Rating (1-5)" Keyboard="Numeric" Text="{Binding NewRating}" />
                        <Editor Placeholder="Review text" Text="{Binding NewReviewText}" HeightRequest="80" />
                        <Button Style="{StaticResource ButtonSecondary}" Text="Submit review" Command="{Binding SubmitReviewCommand}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Center" />
    </Grid>
</ContentPage>
