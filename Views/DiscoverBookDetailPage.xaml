<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAGELY.Views.DiscoverBookDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PAGELY.Models"
    xmlns:vm="clr-namespace:PAGELY.ViewModels"
    x:DataType="vm:DiscoverBookDetailViewModel"
    Title="Book details"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource Paper}">

    <Grid x:Name="DetailRoot" RowDefinitions="Auto,*">

        <!-- Header -->
        <Border
            BackgroundColor="{DynamicResource Surface}"
            Padding="12,10,16,12"
            Stroke="{DynamicResource Divider}"
            StrokeShape="RoundRectangle 0,0,20,20"
            StrokeThickness="1">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                <ImageButton
                    Aspect="AspectFit"
                    BackgroundColor="{DynamicResource SurfaceAlt}"
                    BorderColor="{DynamicResource Divider}"
                    BorderWidth="1"
                    Clicked="OnBackClicked"
                    CornerRadius="21"
                    HeightRequest="42"
                    Padding="0"
                    SemanticProperties.Description="Back"
                    Source="ic_back.svg"
                    WidthRequest="42" />
                <Label
                    Grid.Column="1"
                    FontFamily="OpenSansSemibold"
                    FontSize="17"
                    Padding="12,0,0,0"
                    Text="Book details"
                    TextColor="{DynamicResource Ink}"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Reviews}"
            SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout Padding="20,16,20,20" Spacing="16">

                    <!-- Cover and primary info -->
                    <Border Padding="14" Style="{StaticResource CardBorder}">
                        <Grid ColumnDefinitions="96,*" ColumnSpacing="16">
                            <Border
                                BackgroundColor="{Binding Book.CoverColor}"
                                HeightRequest="144"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0"
                                VerticalOptions="Start"
                                WidthRequest="96">
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="32"
                                    HorizontalOptions="Center"
                                    Text="{Binding Book.Initial}"
                                    TextColor="{DynamicResource Surface}"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label FontSize="20" Style="{StaticResource CardTitle}" Text="{Binding Book.Title}" />
                                <Label FontSize="14" Style="{StaticResource CardMeta}" Text="{Binding Book.Author}" />
                                <Label FontSize="12" Style="{StaticResource Caption}" Text="{Binding Book.Genre}" />
                                <HorizontalStackLayout Spacing="6" Margin="0,4,0,0">
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="13"
                                        Text="{Binding Book.RatingLabel}"
                                        TextColor="{DynamicResource WarmAccent}" />
                                    <Label
                                        Style="{StaticResource CardMeta}"
                                        Text="{Binding Book.RatingCountLabel}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Description -->
                    <Border Padding="16" Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Label Style="{StaticResource SectionCaption}" Text="ABOUT THIS BOOK" />
                            <Label
                                LineBreakMode="WordWrap"
                                Style="{StaticResource PageSubtitle}"
                                Text="{Binding Book.Description}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Reading list action -->
                    <Button
                        Command="{Binding ToggleSaveCommand}"
                        Style="{StaticResource ButtonPrimary}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSaved}" Value="True">
                                <Setter Property="Text" Value="Remove from reading list" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSaved}" Value="False">
                                <Setter Property="Text" Value="Add to reading list" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- Ratings and reviews summary -->
                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource SectionCaption}" Text="RATINGS AND REVIEWS" />
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="22"
                                Text="{Binding Book.Rating, StringFormat='{0:0.0}'}"
                                TextColor="{DynamicResource Ink}" />
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="16"
                                Text="★"
                                TextColor="{DynamicResource WarmAccent}" />
                            <Label
                                Style="{StaticResource CardMeta}"
                                Text="{Binding Book.RatingCountLabel}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label
                            Style="{StaticResource PageSubtitle}"
                            Text="{Binding ReviewStatus}"
                            IsVisible="{Binding ReviewStatus, Converter={StaticResource HasText}}" />
                    </VerticalStackLayout>

                    <!-- Review composer -->
                    <Border Padding="20" Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="10">
                            <Label Style="{StaticResource SectionCaption}" Text="WRITE A REVIEW" />

                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Style="{StaticResource CardMeta}" Text="Your rating:" VerticalOptions="Center" />
                                <Button
                                    BackgroundColor="Transparent"
                                    Command="{Binding SetRatingCommand}"
                                    CommandParameter="1"
                                    FontSize="22"
                                    HeightRequest="36"
                                    WidthRequest="36"
                                    Padding="0"
                                    Text="★"
                                    TextColor="{Binding NewRating, Converter={StaticResource RatingStarColor}, ConverterParameter=1}" />
                                <Button
                                    BackgroundColor="Transparent"
                                    Command="{Binding SetRatingCommand}"
                                    CommandParameter="2"
                                    FontSize="22"
                                    HeightRequest="36"
                                    WidthRequest="36"
                                    Padding="0"
                                    Text="★"
                                    TextColor="{Binding NewRating, Converter={StaticResource RatingStarColor}, ConverterParameter=2}" />
                                <Button
                                    BackgroundColor="Transparent"
                                    Command="{Binding SetRatingCommand}"
                                    CommandParameter="3"
                                    FontSize="22"
                                    HeightRequest="36"
                                    WidthRequest="36"
                                    Padding="0"
                                    Text="★"
                                    TextColor="{Binding NewRating, Converter={StaticResource RatingStarColor}, ConverterParameter=3}" />
                                <Button
                                    BackgroundColor="Transparent"
                                    Command="{Binding SetRatingCommand}"
                                    CommandParameter="4"
                                    FontSize="22"
                                    HeightRequest="36"
                                    WidthRequest="36"
                                    Padding="0"
                                    Text="★"
                                    TextColor="{Binding NewRating, Converter={StaticResource RatingStarColor}, ConverterParameter=4}" />
                                <Button
                                    BackgroundColor="Transparent"
                                    Command="{Binding SetRatingCommand}"
                                    CommandParameter="5"
                                    FontSize="22"
                                    HeightRequest="36"
                                    WidthRequest="36"
                                    Padding="0"
                                    Text="★"
                                    TextColor="{Binding NewRating, Converter={StaticResource RatingStarColor}, ConverterParameter=5}" />
                            </HorizontalStackLayout>

                            <Border Style="{StaticResource FieldBorder}">
                                <Editor
                                    HeightRequest="90"
                                    Placeholder="Share your thoughts about this book..."
                                    Text="{Binding NewReviewText}" />
                            </Border>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button
                                    Command="{Binding CancelReviewCommand}"
                                    IsEnabled="{Binding IsSubmitting, Converter={StaticResource InverseBool}}"
                                    Style="{StaticResource ButtonSecondary}"
                                    Text="Cancel" />
                                <Button
                                    Grid.Column="1"
                                    Command="{Binding SubmitReviewCommand}"
                                    IsEnabled="{Binding IsSubmitting, Converter={StaticResource InverseBool}}"
                                    Style="{StaticResource ButtonPrimary}"
                                    Text="Submit review">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding HasExistingReview}" Value="True">
                                            <Setter Property="Text" Value="Update review" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>

                            <ActivityIndicator
                                HorizontalOptions="Center"
                                IsRunning="{Binding IsSubmitting}"
                                IsVisible="{Binding IsSubmitting}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        BackgroundColor="{DynamicResource SurfaceAlt}"
                        Padding="16,12"
                        StrokeThickness="0">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="16"
                                Text="Reader Reviews"
                                TextColor="{DynamicResource Ink}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Style="{StaticResource Caption}"
                                Text="{Binding Reviews.Count, StringFormat='{0} reviews'}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <Label HorizontalTextAlignment="Center" Padding="20" Style="{StaticResource PageSubtitle}" Text="No reviews yet. Be the first to write one." />
            </CollectionView.EmptyView>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Review">
                    <Border
                        BackgroundColor="{DynamicResource SurfaceAlt}"
                        Padding="16,12"
                        StrokeThickness="0">
                        <VerticalStackLayout Spacing="8">
                            <!-- Top row: avatar + name + timestamp + rating -->
                            <Grid ColumnDefinitions="40,*" ColumnSpacing="10">
                                <Border
                                    BackgroundColor="{DynamicResource Primary}"
                                    HeightRequest="40"
                                    StrokeShape="RoundRectangle 20"
                                    StrokeThickness="0"
                                    WidthRequest="40">
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="16"
                                        HorizontalOptions="Center"
                                        Text="{Binding UserInitial}"
                                        TextColor="{DynamicResource Surface}"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="14"
                                            Text="{Binding DisplayName}"
                                            TextColor="{DynamicResource Ink}" />
                                        <Label
                                            Grid.Column="1"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="12"
                                            Text="{Binding Rating, StringFormat='★ {0}'}"
                                            TextColor="{DynamicResource WarmAccent}" />
                                    </Grid>
                                    <Label
                                        Style="{StaticResource Caption}"
                                        Text="{Binding CreatedAt, StringFormat='{0:MMM d, yyyy}'}" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Review body -->
                            <Label
                                FontSize="14"
                                LineBreakMode="WordWrap"
                                LineHeight="1.35"
                                Margin="50,0,0,0"
                                Text="{Binding ReviewText}" />

                            <!-- Interaction row -->
                            <HorizontalStackLayout Margin="50,4,0,0" Spacing="12" VerticalOptions="Center">
                                <ImageButton
                                    BackgroundColor="Transparent"
                                    Command="{Binding BindingContext.LikeReviewCommand, Source={x:Reference DetailRoot}}"
                                    CommandParameter="{Binding .}"
                                    HeightRequest="24"
                                    IsEnabled="{Binding IsLiking, Converter={StaticResource InverseBool}}"
                                    Padding="0"
                                    Source="heart_outline.svg"
                                    WidthRequest="24">
                                    <ImageButton.Triggers>
                                        <DataTrigger TargetType="ImageButton" Binding="{Binding IsLikedByCurrentUser}" Value="True">
                                            <Setter Property="Source" Value="heart_filled.svg" />
                                        </DataTrigger>
                                    </ImageButton.Triggers>
                                </ImageButton>
                                <Label
                                    FontSize="12"
                                    Text="{Binding LikeCount}"
                                    TextColor="{DynamicResource Muted}"
                                    VerticalOptions="Center" />
                                <Button
                                    BackgroundColor="Transparent"
                                    Command="{Binding BindingContext.EditReviewCommand, Source={x:Reference DetailRoot}}"
                                    CommandParameter="{Binding .}"
                                    FontSize="12"
                                    HeightRequest="28"
                                    IsVisible="{Binding IsOwnReview}"
                                    Padding="0"
                                    Text="Edit"
                                    TextColor="{DynamicResource Primary}" />
                                <Button
                                    BackgroundColor="Transparent"
                                    Command="{Binding BindingContext.ReportReviewCommand, Source={x:Reference DetailRoot}}"
                                    CommandParameter="{Binding .}"
                                    FontSize="12"
                                    HeightRequest="28"
                                    Padding="0"
                                    Text="Report"
                                    TextColor="{DynamicResource Muted}" />
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="0,4,0,0" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator
            Grid.Row="1"
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Center" />
    </Grid>
</ContentPage>
