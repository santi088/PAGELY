<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAGELY.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PAGELY.Models"
    xmlns:vm="clr-namespace:PAGELY.ViewModels"
    x:Name="Library"
    x:DataType="vm:LibraryViewModel"
    Title="Library"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource Paper}">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout
            Grid.Row="0"
            HorizontalOptions="Fill"
            Padding="{StaticResource Space16}"
            Spacing="2">
            <Label Style="{StaticResource PageTitle}" Text="Library" />
            <Label Style="{StaticResource PageSubtitle}" Text="{Binding Books.Count, StringFormat='{0} books'}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1">
            <CollectionView
                IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBool}}"
                ItemsSource="{Binding Books}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="16" />
                </CollectionView.ItemsLayout>
                <CollectionView.Header>
                    <BoxView HeightRequest="{StaticResource Space12}" Color="Transparent" />
                </CollectionView.Header>
                <CollectionView.Footer>
                    <BoxView HeightRequest="{StaticResource Space32}" Color="Transparent" />
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Book">
                        <VerticalStackLayout Spacing="4" Padding="2,0">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.OpenCommand, Source={x:Reference Library}}"
                                    CommandParameter="{Binding .}" />
                            </VerticalStackLayout.GestureRecognizers>

                            <!-- Cover -->
                            <Border Style="{StaticResource BookCover}"
                                    HeightRequest="180"
                                    WidthRequest="120"
                                    HorizontalOptions="Center">
                                <Grid>
                                    <Image
                                        Aspect="AspectFill"
                                        IsVisible="{Binding CoverPath, Converter={StaticResource HasValue}}"
                                        Source="{Binding CoverPath}" />
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="28"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding CoverPath, Converter={StaticResource InverseHasValue}}"
                                        Text="{Binding Initial}"
                                        TextColor="{DynamicResource Surface}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>

                            <!-- Title -->
                            <Label
                                FontSize="13"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="TailTruncation"
                                LineHeight="1.2"
                                MaxLines="2"
                                MaximumWidthRequest="120"
                                Style="{StaticResource CardTitle}"
                                Text="{Binding Title}" />

                            <!-- Author -->
                            <Label
                                FontSize="11"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="TailTruncation"
                                MaxLines="1"
                                MaximumWidthRequest="120"
                                Style="{StaticResource CardMeta}"
                                Text="{Binding Author}" />

                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout
                HorizontalOptions="Center"
                IsVisible="{Binding IsEmpty}"
                Padding="40,0"
                Spacing="12"
                VerticalOptions="Center">
                <Border
                    BackgroundColor="{DynamicResource SurfaceAlt}"
                    HeightRequest="64"
                    HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 32"
                    StrokeThickness="0"
                    WidthRequest="64">
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="26"
                        HorizontalOptions="Center"
                        Text="P"
                        TextColor="{DynamicResource Primary}"
                        VerticalOptions="Center" />
                </Border>
                <Label
                    Style="{StaticResource EmptyStateTitle}"
                    Text="Your shelves are empty" />
                <Label
                    Style="{StaticResource EmptyStateSubtitle}"
                    Text="Import EPUB, PDF or TXT files already on this device." />
            </VerticalStackLayout>

            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Center" />

            <!-- Floating import button -->
            <Button
                x:Name="ImportFab"
                Command="{Binding ImportCommand}"
                Clicked="OnImportClicked"
                HeightRequest="{StaticResource HeightFAB}"
                HorizontalOptions="End"
                Style="{StaticResource FAB}"
                Text="+"
                VerticalOptions="End"
                WidthRequest="{StaticResource HeightFAB}"
                Margin="0,0,20,24" />
        </Grid>
    </Grid>
</ContentPage>
