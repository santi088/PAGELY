<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAGELY.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PAGELY.Models"
    xmlns:vm="clr-namespace:PAGELY.ViewModels"
    x:Name="Library"
    x:DataType="vm:LibraryViewModel"
    Title="Library"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource Paper}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header: a raised panel with the title, the book count and the import button. -->
        <Border
            BackgroundColor="{DynamicResource Surface}"
            Padding="24,28,20,20"
            StrokeShape="RoundRectangle 0,0,28,28"
            StrokeThickness="0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                    <Label
                        FontSize="30"
                        Style="{StaticResource PageTitle}"
                        Text="Library" />
                    <Label
                        Style="{StaticResource PageSubtitle}"
                        Text="{Binding Books.Count, StringFormat='{0} in your library'}" />
                </VerticalStackLayout>
                <Button
                    Grid.Column="1"
                    Command="{Binding ImportCommand}"
                    Style="{StaticResource ButtonIconPrimary}"
                    Text="+"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <CollectionView
                IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBool}}"
                ItemsSource="{Binding Books}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="14" />
                </CollectionView.ItemsLayout>
                <CollectionView.Header>
                    <BoxView HeightRequest="16" Color="Transparent" />
                </CollectionView.Header>
                <CollectionView.Footer>
                    <BoxView HeightRequest="24" Color="Transparent" />
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Book">
                        <Grid Padding="8,0">
                            <Border Style="{StaticResource CardBorder}" Padding="12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.OpenCommand, Source={x:Reference Library}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="72,*" ColumnSpacing="14">

                                    <!-- Cover, or the book's initial when it has none. -->
                                    <Border
                                        BackgroundColor="{DynamicResource Spine}"
                                        HeightRequest="104"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0"
                                        VerticalOptions="Start"
                                        WidthRequest="72">
                                        <Grid>
                                            <Image
                                                Aspect="AspectFill"
                                                IsVisible="{Binding CoverPath, Converter={StaticResource HasValue}}"
                                                Source="{Binding CoverPath}" />
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                FontSize="26"
                                                HorizontalOptions="Center"
                                                IsVisible="{Binding CoverPath, Converter={StaticResource InverseHasValue}}"
                                                Text="{Binding Initial}"
                                                TextColor="{DynamicResource Surface}"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Label
                                            FontSize="16"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            Style="{StaticResource CardTitle}"
                                            Text="{Binding Title}" />
                                        <Label
                                            FontSize="12"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="1"
                                            Style="{StaticResource PageSubtitle}"
                                            Text="{Binding Author}" />

                                        <HorizontalStackLayout Margin="0,6,0,0" Spacing="8">
                                            <Border Style="{StaticResource ChipBorder}">
                                                <Label
                                                    FontFamily="OpenSansSemibold"
                                                    FontSize="11"
                                                    Text="{Binding StatusLabel}"
                                                    TextColor="{Binding StatusLabel, Converter={StaticResource StatusColor}}" />
                                            </Border>
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                FontSize="12"
                                                Text="{Binding ProgressLabel}"
                                                TextColor="{DynamicResource InkSoft}"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <Border
                                            HeightRequest="6"
                                            Margin="0,4,0,0"
                                            Style="{StaticResource ProgressPill}">
                                            <ProgressBar
                                                BackgroundColor="Transparent"
                                                HeightRequest="6"
                                                Progress="{Binding ProgressPercent, Converter={StaticResource PercentToProgress}}"
                                                ProgressColor="{DynamicResource Primary}" />
                                        </Border>

                                        <Button
                                            Command="{Binding BindingContext.ContinueCommand, Source={x:Reference Library}}"
                                            CommandParameter="{Binding .}"
                                            FontSize="13"
                                            HeightRequest="36"
                                            HorizontalOptions="Start"
                                            Margin="0,8,0,0"
                                            Padding="18,0"
                                            Style="{StaticResource ButtonPrimary}"
                                            Text="Read" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout
                IsVisible="{Binding IsEmpty}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="40,0"
                Spacing="12">
                <Border
                    BackgroundColor="{DynamicResource SurfaceAlt}"
                    HeightRequest="64"
                    HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="0"
                    WidthRequest="64">
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="26"
                        HorizontalOptions="Center"
                        Text="P"
                        TextColor="{DynamicResource Primary}"
                        VerticalOptions="Center" />
                </Border>
                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="19"
                    HorizontalTextAlignment="Center"
                    Margin="0,2,0,0"
                    Text="Your shelves are empty"
                    TextColor="{DynamicResource Ink}" />
                <Label
                    HorizontalTextAlignment="Center"
                    MaximumWidthRequest="290"
                    Style="{StaticResource PageSubtitle}"
                    Text="Import EPUB, PDF or TXT files already on this device. PAGELY works fully offline." />
                <Button
                    Command="{Binding ImportCommand}"
                    HeightRequest="50"
                    HorizontalOptions="Center"
                    Margin="0,10,0,0"
                    Style="{StaticResource ButtonPrimary}"
                    Text="Import a book"
                    WidthRequest="190" />
            </VerticalStackLayout>

            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>