<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAGELY.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PAGELY.Models"
    xmlns:vm="clr-namespace:PAGELY.ViewModels"
    x:Name="Search"
    x:DataType="vm:SearchViewModel"
    Title="Search"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource Paper}">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <VerticalStackLayout Padding="20,16,20,12" Spacing="2">
            <Label Style="{StaticResource PageTitle}" Text="Search" />
            <Label
                Style="{StaticResource PageSubtitle}"
                Text="Find a title, author, genre or status" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Padding="20,0,20,12" Spacing="10">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button
                    Command="{Binding SetLibraryScopeCommand}"
                    Style="{StaticResource ButtonSecondary}"
                    Text="My Library">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsCommunityScope}" Value="False">
                            <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                            <Setter Property="TextColor" Value="{DynamicResource Surface}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button
                    Grid.Column="1"
                    Command="{Binding SetCommunityScopeCommand}"
                    Style="{StaticResource ButtonSecondary}"
                    Text="Community">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsCommunityScope}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                            <Setter Property="TextColor" Value="{DynamicResource Surface}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Border Style="{StaticResource FieldBorder}">
                    <SearchBar
                        x:Name="SearchBar"
                        CancelButtonColor="{DynamicResource Primary}"
                        FontFamily="OpenSansRegular"
                        HeightRequest="46"
                        Placeholder="Title, author, genre, or status"
                        PlaceholderColor="{DynamicResource Muted}"
                        Text="{Binding Query}"
                        TextColor="{DynamicResource Ink}" />
                </Border>
                <Button
                    Grid.Column="1"
                    Clicked="OnFilterToggleClicked"
                    FontSize="14"
                    HeightRequest="46"
                    Padding="16,0"
                    Style="{StaticResource ButtonSecondary}"
                    Text="Filters" />
            </Grid>

            <Border
                IsVisible="{Binding IsFilterVisible}"
                Padding="14"
                Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Margin="2,0,0,0" Style="{StaticResource SectionCaption}" Text="FILTER AND SORT" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Style="{StaticResource FieldBorder}">
                            <Picker
                                FontFamily="OpenSansRegular"
                                HeightRequest="46"
                                ItemsSource="{Binding StatusFilters}"
                                SelectedItem="{Binding SelectedStatus}"
                                TextColor="{DynamicResource Ink}"
                                Title="Status"
                                TitleColor="{DynamicResource Muted}" />
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource FieldBorder}">
                            <Picker
                                FontFamily="OpenSansRegular"
                                HeightRequest="46"
                                ItemsSource="{Binding Genres}"
                                SelectedItem="{Binding SelectedGenre}"
                                TextColor="{DynamicResource Ink}"
                                Title="Genre"
                                TitleColor="{DynamicResource Muted}" />
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource FieldBorder}">
                        <Picker
                            FontFamily="OpenSansRegular"
                            HeightRequest="46"
                            ItemsSource="{Binding SortOptions}"
                            SelectedItem="{Binding SelectedSort}"
                            TextColor="{DynamicResource Ink}"
                            Title="Sort by"
                            TitleColor="{DynamicResource Muted}" />
                    </Border>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <Label
            Grid.Row="2"
            Margin="20,0,20,8"
            Style="{StaticResource PageSubtitle}"
            Text="{Binding CommunityMessage}"
            IsVisible="{Binding IsCommunityScope}" />

        <Grid Grid.Row="3">
            <CollectionView
                IsVisible="{Binding IsCommunityScope, Converter={StaticResource InverseBool}}"
                ItemsSource="{Binding Books}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="12" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Book">
                        <Grid Padding="20,0">
                            <Border Padding="12" Style="{StaticResource CardBorder}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.OpenCommand, Source={x:Reference Search}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="52,*" ColumnSpacing="12">
                                    <Border
                                        BackgroundColor="{DynamicResource Spine}"
                                        HeightRequest="76"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="0"
                                        VerticalOptions="Start"
                                        WidthRequest="52">
                                        <Grid>
                                            <Image
                                                Aspect="AspectFill"
                                                IsVisible="{Binding CoverPath, Converter={StaticResource HasValue}}"
                                                Source="{Binding CoverPath}" />
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                FontSize="20"
                                                HorizontalOptions="Center"
                                                IsVisible="{Binding CoverPath, Converter={StaticResource InverseHasValue}}"
                                                Text="{Binding Initial}"
                                                TextColor="{DynamicResource Surface}"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label FontSize="15" Style="{StaticResource CardTitle}" Text="{Binding Title}" />
                                        <Label FontSize="12" Style="{StaticResource CardMeta}" Text="{Binding Author}" />
                                        <Label FontSize="11" Style="{StaticResource Caption}" Text="{Binding StatusLabel}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout
                HorizontalOptions="Center"
                IsVisible="{Binding IsEmpty}"
                Padding="40,0"
                Spacing="10"
                VerticalOptions="Center">
                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="19"
                    HorizontalTextAlignment="Center"
                    Text="No books found"
                    TextColor="{DynamicResource Ink}" />
                <Label
                    HorizontalTextAlignment="Center"
                    MaximumWidthRequest="290"
                    Style="{StaticResource PageSubtitle}"
                    Text="Nothing matches this search yet. Try another title, author, genre or status." />
            </VerticalStackLayout>

            <CollectionView
                IsVisible="{Binding IsCommunityScope}"
                ItemsSource="{Binding CommunityBooks}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="12" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DiscoverBook">
                        <Grid Padding="20,0">
                            <Border Padding="12" Style="{StaticResource CardBorder}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.OpenCommunityCommand, Source={x:Reference Search}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="52,*" ColumnSpacing="12">
                                    <Border
                                        BackgroundColor="{Binding CoverColor}"
                                        HeightRequest="76"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="0"
                                        VerticalOptions="Start"
                                        WidthRequest="52">
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="20"
                                            HorizontalOptions="Center"
                                            Text="{Binding Initial}"
                                            TextColor="{DynamicResource Surface}"
                                            VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label FontSize="15" Style="{StaticResource CardTitle}" Text="{Binding Title}" />
                                        <Label FontSize="12" Style="{StaticResource CardMeta}" Text="{Binding Author}" />
                                        <Label FontSize="11" Style="{StaticResource Caption}" Text="{Binding RatingLabel}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout
                HorizontalOptions="Center"
                IsVisible="{Binding IsCommunityBusy}"
                Padding="40,0"
                Spacing="8"
                VerticalOptions="Center">
                <ActivityIndicator
                    IsRunning="{Binding IsCommunityBusy}"
                    IsVisible="{Binding IsCommunityBusy}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
