<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAGELY.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PAGELY.ViewModels"
    x:DataType="vm:ProfileViewModel"
    Title="Profile"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource Paper}">

    <Grid RowDefinitions="Auto,*">
        <Border
            BackgroundColor="{DynamicResource Surface}"
            Padding="24,28,20,20"
            StrokeShape="RoundRectangle 0,0,28,28"
            StrokeThickness="0">
            <VerticalStackLayout Spacing="4">
                <Label FontSize="30" Style="{StaticResource PageTitle}" Text="Profile" />
                <Label Style="{StaticResource PageSubtitle}" Text="Your reading identity and account" />
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,16,20,32" Spacing="12">

                <Border Padding="16" Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource SectionCaption}" Text="ACCOUNT" />
                        <Label
                            IsVisible="{Binding IsAuthenticated}"
                            FontSize="18"
                            Style="{StaticResource CardTitle}"
                            Text="{Binding AccountEmail}" />
                        <Button
                            IsVisible="{Binding IsAuthenticated}"
                            Style="{StaticResource ButtonSecondary}"
                            Text="Sign out"
                            Command="{Binding LogoutCommand}" />

                        <VerticalStackLayout IsVisible="{Binding IsAuthenticated, Converter={StaticResource InverseBool}}" Spacing="12">
                            <Border Padding="12" Style="{StaticResource CardBorder}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Style="{StaticResource CardTitle}" Text="Sign in" />
                                    <Entry Placeholder="Email" Text="{Binding LoginEmail}" Keyboard="Email" />
                                    <Entry Placeholder="Password" Text="{Binding LoginPassword}" IsPassword="True" />
                                    <Button Style="{StaticResource ButtonPrimary}" Text="Sign in" Command="{Binding LoginCommand}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Padding="12" Style="{StaticResource CardBorder}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Style="{StaticResource CardTitle}" Text="Create account" />
                                    <Entry Placeholder="Email" Text="{Binding RegisterEmail}" Keyboard="Email" />
                                    <Entry Placeholder="Password" Text="{Binding RegisterPassword}" IsPassword="True" />
                                    <Entry Placeholder="First name" Text="{Binding FirstName}" />
                                    <Entry Placeholder="Last name" Text="{Binding LastName}" />
                                    <Button Style="{StaticResource ButtonSecondary}" Text="Register" Command="{Binding RegisterCommand}" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <Label Style="{StaticResource PageSubtitle}" Text="{Binding StatusMessage}" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16" Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource SectionCaption}" Text="READING ACTIVITY" />
                        <Button Style="{StaticResource ButtonSecondary}" Text="Reading statistics" Command="{Binding OpenStatsCommand}" />
                        <Button Style="{StaticResource ButtonSecondary}" Text="Reading history" Command="{Binding OpenHistoryCommand}" />
                        <Button Style="{StaticResource ButtonSecondary}" Text="Reading list" Command="{Binding OpenReadingListCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16" Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource SectionCaption}" Text="COMMUNITY" />
                        <Button Style="{StaticResource ButtonSecondary}" Text="My reviews" Command="{Binding OpenReviewsCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16" Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource SectionCaption}" Text="APP" />
                        <Button Style="{StaticResource ButtonSecondary}" Text="Settings" Command="{Binding OpenSettingsCommand}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
