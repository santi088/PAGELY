<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAGELY.Views.DiscoverPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PAGELY.ViewModels"
    x:Name="Discover"
    x:DataType="vm:DiscoverViewModel"
    Title="Discover"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource Paper}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <Border
            BackgroundColor="{DynamicResource Surface}"
            Padding="24,28,20,20"
            StrokeShape="RoundRectangle 0,0,28,28"
            StrokeThickness="0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label FontSize="30" Style="{StaticResource PageTitle}" Text="Discover" />
                    <Label
                        Style="{StaticResource PageSubtitle}"
                        Text="Find your next read. Sample catalog for now." />
                </VerticalStackLayout>
                <Button
                    Grid.Column="1"
                    Command="{Binding OpenSearchCommand}"
                    Style="{StaticResource ButtonIcon}"
                    Text="Search"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Filters: genre buttons and sort order -->
        <VerticalStackLayout
            Grid.Row="1"
            Padding="0,14,0,6"
            Spacing="10">
            <CollectionView
                HeightRequest="44"
                Margin="12,0"
                ItemsSource="{Binding Genres}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="8" Orientation="Horizontal" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GenreChip">
                        <Border
                            BackgroundColor="{DynamicResource Surface}"
                            Padding="14,8"
                            Stroke="{DynamicResource Divider}"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="1"
                            VerticalOptions="Center">
                            <Border.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsSelected}"
                                    TargetType="Border"
                                    Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.SelectGenreCommand, Source={x:Reference Discover}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="13"
                                Text="{Binding Name}"
                                TextColor="{DynamicResource Ink}">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsSelected}"
                                        TargetType="Label"
                                        Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="10"
                Padding="20,0">
                <Label
                    Style="{StaticResource PageSubtitle}"
                    Text="Sort by"
                    VerticalOptions="Center" />
                <Picker
                    Grid.Column="1"
                    FontSize="14"
                    ItemsSource="{Binding SortOptions}"
                    SelectedItem="{Binding SelectedSort}"
                    TextColor="{DynamicResource Ink}" />
                <Label
                    Grid.Column="2"
                    Style="{StaticResource CardMeta}"
                    Text="{Binding ResultsLabel}"
                    VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>

        <!-- Book list -->
        <Grid Grid.Row="2">
            <CollectionView
                IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBool}}"
                ItemsSource="{Binding Books}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="14" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.Header>
                    <BoxView HeightRequest="8" Color="Transparent" />
                </CollectionView.Header>
                <CollectionView.Footer>
                    <BoxView HeightRequest="24" Color="Transparent" />
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DiscoverItem">
                        <Grid Padding="20,0">
                            <Border Padding="14" Style="{StaticResource CardBorder}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.OpenCommand, Source={x:Reference Discover}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="72,*" ColumnSpacing="14">

                                    <Border
                                        BackgroundColor="{Binding Book.CoverColor}"
                                        HeightRequest="104"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0"
                                        VerticalOptions="Start"
                                        WidthRequest="72">
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="26"
                                            HorizontalOptions="Center"
                                            Text="{Binding Book.Initial}"
                                            TextColor="White"
                                            VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="4"
                                        VerticalOptions="Center">
                                        <Label
                                            FontSize="16"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            Style="{StaticResource CardTitle}"
                                            Text="{Binding Book.Title}" />
                                        <Label
                                            FontSize="12"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="1"
                                            Style="{StaticResource PageSubtitle}"
                                            Text="{Binding Book.Author}" />

                                        <HorizontalStackLayout Margin="0,6,0,0" Spacing="8">
                                            <Border Style="{StaticResource ChipBorder}">
                                                <Label
                                                    FontFamily="OpenSansSemibold"
                                                    FontSize="11"
                                                    Text="{Binding Book.Genre}"
                                                    TextColor="{DynamicResource InkSoft}" />
                                            </Border>
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                FontSize="12"
                                                Text="{Binding Book.RatingLabel}"
                                                TextColor="{DynamicResource WarmAccent}"
                                                VerticalOptions="Center" />
                                            <Label
                                                Style="{StaticResource CardMeta}"
                                                Text="{Binding Book.RatingCountLabel}"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <Button
                                            Command="{Binding BindingContext.ToggleSaveCommand, Source={x:Reference Discover}}"
                                            CommandParameter="{Binding .}"
                                            FontSize="13"
                                            HeightRequest="36"
                                            HorizontalOptions="Start"
                                            Margin="0,8,0,0"
                                            Padding="18,0"
                                            Style="{StaticResource ButtonSecondary}"
                                            Text="{Binding SaveLabel}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout
                HorizontalOptions="Center"
                IsVisible="{Binding IsEmpty}"
                Padding="40,0"
                Spacing="8"
                VerticalOptions="Center">
                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="18"
                    HorizontalTextAlignment="Center"
                    Text="No books match these filters"
                    TextColor="{DynamicResource Ink}" />
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource PageSubtitle}"
                    Text="Try another genre or choose All." />
            </VerticalStackLayout>

            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>