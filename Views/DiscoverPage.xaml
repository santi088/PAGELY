<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAGELY.Views.DiscoverPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PAGELY.ViewModels"
    x:Name="Discover"
    x:DataType="vm:DiscoverViewModel"
    Title="Discover"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource Paper}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <Border Style="{StaticResource HeaderBorder}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label Style="{StaticResource HeaderTitle}" Text="Discover" />
                    <Label Style="{StaticResource HeaderSubtitle}" Text="Find your next read. Sample catalog for now." />
                </VerticalStackLayout>
                <Button
                    Grid.Column="1"
                    Command="{Binding OpenSearchCommand}"
                    HeightRequest="40"
                    Padding="14,0"
                    Style="{StaticResource ButtonSecondary}"
                    Text="Search"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Filters: genre buttons and sort order -->
        <VerticalStackLayout
            Grid.Row="1"
            Padding="{StaticResource Space16}"
            Spacing="10">
            <CollectionView
                HeightRequest="44"
                Margin="0,0,0,0"
                ItemsSource="{Binding Genres}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="8" Orientation="Horizontal" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GenreChip">
                        <Border Style="{StaticResource ChipBorder}"
                                Padding="14,8"
                                HeightRequest="{StaticResource HeightChip}"
                                VerticalOptions="Center">
                            <Border.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsSelected}"
                                    TargetType="Border"
                                    Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.SelectGenreCommand, Source={x:Reference Discover}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="13"
                                Text="{Binding Name}"
                                TextColor="{DynamicResource Ink}">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsSelected}"
                                        TargetType="Label"
                                        Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="10">
                <Label
                    Style="{StaticResource PageSubtitle}"
                    Text="Sort by"
                    VerticalOptions="Center" />
                <Button
                    Grid.Column="1"
                    Command="{Binding OpenSortCommand}"
                    Style="{StaticResource ButtonSecondary}"
                    Text="{Binding SelectedSort}" />
                <Label
                    Grid.Column="2"
                    Style="{StaticResource CardMeta}"
                    Text="{Binding ResultsLabel}"
                    VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>

        <!-- Book list -->
        <Grid Grid.Row="2">
            <CollectionView
                IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBool}}"
                ItemsSource="{Binding Books}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="14" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DiscoverItem">
                        <Grid Padding="16,0,16,0">
                            <Border Style="{StaticResource CardBorder}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.OpenCommand, Source={x:Reference Discover}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="12">
                                    <Border Style="{StaticResource BookCover}"
                                            HeightRequest="76"
                                            WidthRequest="52"
                                            VerticalOptions="Start">
                                        <Grid>
                                            <Image
                                                Aspect="AspectFill"
                                                IsVisible="{Binding Book.CoverUrl, Converter={StaticResource HasText}}"
                                                Source="{Binding Book.CoverUrl}" />
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                FontSize="20"
                                                HorizontalOptions="Center"
                                                IsVisible="{Binding Book.CoverUrl, Converter={StaticResource InverseHasText}}"
                                                Text="{Binding Book.Initial}"
                                                TextColor="{DynamicResource Surface}"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label FontSize="15" Style="{StaticResource CardTitle}" Text="{Binding Book.Title}" />
                                        <Label FontSize="12" Style="{StaticResource CardMeta}" Text="{Binding Book.Author}" />
                                        <Label FontSize="12" Style="{StaticResource Caption}" Text="{Binding Book.RatingLabel}" />
                                    </VerticalStackLayout>
                                    <Button
                                        Grid.Column="2"
                                        Command="{Binding BindingContext.ToggleSaveCommand, Source={x:Reference Discover}}"
                                        CommandParameter="{Binding .}"
                                        FontSize="12"
                                        HeightRequest="36"
                                        Padding="12,0"
                                        Style="{StaticResource ButtonSecondary}"
                                        Text="{Binding SaveLabel}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout
                HorizontalOptions="Center"
                IsVisible="{Binding IsEmpty}"
                Padding="40,0"
                Spacing="8"
                VerticalOptions="Center">
                <Label FontFamily="OpenSansSemibold" FontSize="19" HorizontalTextAlignment="Center" Text="No books found" TextColor="{DynamicResource Ink}" />
                <Label HorizontalTextAlignment="Center" MaximumWidthRequest="290" Style="{StaticResource PageSubtitle}" Text="Try a different genre or search term." />
            </VerticalStackLayout>

            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
