<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAGELY.Views.BookDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PAGELY.ViewModels"
    x:DataType="vm:BookDetailViewModel"
    Title="Book"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource Paper}">

    <Grid RowDefinitions="Auto,*">

        <Border Style="{StaticResource HeaderBorder}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" Padding="12,10,16,12">
                <ImageButton Style="{StaticResource HeaderBackButton}" Clicked="OnBackClicked" />
                <Label Grid.Column="1" Style="{StaticResource HeaderTitle}" Text="Book Details" VerticalOptions="Center" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,16,20,40" Spacing="14">

                <Border Style="{StaticResource CardBorder}">
                    <Grid ColumnDefinitions="96,*" ColumnSpacing="16">
                        <Border Style="{StaticResource BookCover}"
                                HeightRequest="144"
                                WidthRequest="96"
                                VerticalOptions="Start">
                            <Grid>
                                <Image
                                    Aspect="AspectFill"
                                    IsVisible="{Binding Book.CoverPath, Converter={StaticResource HasValue}}"
                                    Source="{Binding Book.CoverPath}" />
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="28"
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding Book.CoverPath, Converter={StaticResource InverseHasValue}}"
                                    Text="{Binding Book.Initial}"
                                    TextColor="{DynamicResource Surface}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                            <Label
                                FontSize="18"
                                MaxLines="3"
                                Style="{StaticResource CardTitle}"
                                Text="{Binding Title}" />
                            <Label
                                FontSize="13"
                                Style="{StaticResource CardMeta}"
                                Text="{Binding Author}" />
                            <Label Style="{StaticResource Caption}" Text="{Binding Book.LastReadLabel}" />
                            <Border
                                HorizontalOptions="Start"
                                Margin="0,4,0,0"
                                Style="{StaticResource ChipBorder}">
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="11"
                                    Text="{Binding SelectedStatus}"
                                    TextColor="{Binding SelectedStatus, Converter={StaticResource StatusColor}}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Padding="16" Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Style="{StaticResource SectionCaption}" Text="READING PROGRESS" VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontFamily="OpenSansSemibold"
                                FontSize="22"
                                Text="{Binding Book.ProgressLabel}"
                                TextColor="{DynamicResource Ink}" />
                        </Grid>
                        <Border HeightRequest="8" Style="{StaticResource ProgressPill}">
                            <ProgressBar
                                BackgroundColor="Transparent"
                                HeightRequest="8"
                                Progress="{Binding Book.ProgressPercent, Converter={StaticResource PercentToProgress}}"
                                ProgressColor="{DynamicResource Primary}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Margin="0,6,0,0" Spacing="10">
                    <Button
                        Command="{Binding ReadCommand}"
                        HeightRequest="{StaticResource HeightButton}"
                        Style="{StaticResource ButtonPrimary}"
                        Text="Read" />
                    <Button
                        Command="{Binding DeleteCommand}"
                        HeightRequest="{StaticResource HeightButton}"
                        Style="{StaticResource ButtonSecondary}"
                        Text="Remove from library"
                        TextColor="{DynamicResource Danger}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
