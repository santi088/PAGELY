<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAGELY.Views.MyReviewsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PAGELY.Models"
    xmlns:vm="clr-namespace:PAGELY.ViewModels"
    x:DataType="vm:MyReviewsViewModel"
    Title="My reviews"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource Paper}">

    <Grid RowDefinitions="Auto,*">
        <Border
            BackgroundColor="{DynamicResource Surface}"
            Padding="24,28,20,20"
            StrokeShape="RoundRectangle 0,0,28,28"
            StrokeThickness="0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <ImageButton
                    Aspect="AspectFit"
                    BackgroundColor="{DynamicResource SurfaceAlt}"
                    BorderColor="{DynamicResource Divider}"
                    BorderWidth="1"
                    Clicked="OnBackClicked"
                    CornerRadius="21"
                    HeightRequest="42"
                    Padding="0"
                    Source="ic_back.svg"
                    WidthRequest="42" />
                <Label
                    Grid.Column="1"
                    FontSize="28"
                    Style="{StaticResource PageTitle}"
                    Text="My reviews"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <CollectionView
                IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBool}}"
                ItemsSource="{Binding Reviews}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="12" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Review">
                        <Grid Padding="20,0">
                            <Border Padding="12" Style="{StaticResource CardBorder}">
                                <VerticalStackLayout Spacing="4">
                                    <Label FontSize="13" Style="{StaticResource CardTitle}" Text="{Binding UserEmail}" />
                                    <Label FontSize="12" Style="{StaticResource Caption}" Text="{Binding Rating, StringFormat='Rating: {0}'}" />
                                    <Label FontSize="14" Text="{Binding ReviewText}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout
                HorizontalOptions="Center"
                IsVisible="{Binding IsEmpty}"
                Padding="40,0"
                Spacing="8"
                VerticalOptions="Center">
                <Label FontSize="19" HorizontalTextAlignment="Center" Style="{StaticResource PageTitle}" Text="No reviews yet" />
                <Label HorizontalTextAlignment="Center" Style="{StaticResource PageSubtitle}" Text="{Binding StatusMessage}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
